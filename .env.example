# ============================================================
# KONFIGURASI SMART LOGISTICS WEATHER-AIR QUALITY RISK PIPELINE
# ============================================================
# Salin file ini menjadi .env lalu isi nilai rahasia yang diperlukan.
# Jangan commit file .env yang berisi token, password, App Password,
# API key, JWT secret, atau credential asli ke Git.

# ============================================================
# GCP
# ============================================================
PROJECT_ID=jcdeah-009
REGION=asia-southeast2

RAW_BUCKET=jcdeah-009-smart-logistics-raw
SILVER_BUCKET=jcdeah-009-smart-logistics-silver
TEMP_BUCKET=jcdeah-009-smart-logistics-temp

# ============================================================
# BMKG
# ============================================================
# Endpoint peringatan dini cuaca BMKG yang digunakan oleh ingestion.
BMKG_URL_ID=https://www.bmkg.go.id/alerts/nowcast/id
BMKG_URL_EN=https://www.bmkg.go.id/alerts/nowcast/en

# ============================================================
# DATA LOGISTIK
# ============================================================
# Lokasi dataset historis logistik pada komputer host.
LOGISTICS_DATA_PATH=data/raw/logistics/Transportation_and_Logistics_Tracking_Dataset.xlsx

# ============================================================
# OPENAQ
# ============================================================
# API key diperlukan sesuai konfigurasi akses OpenAQ yang digunakan.
# Jangan menaruh API key asli di file yang di-commit ke Git.
OPENAQ_API_URL=https://api.openaq.org/v3/parameters/2/latest
OPENAQ_API_KEY=
OPENAQ_TOPIC=openaq-events

# ============================================================
# GOOGLE CLOUD AUTHENTICATION
# ============================================================
GOOGLE_CLOUD_PROJECT=jcdeah-009

# Path credential untuk container Airflow.
# File pada host dipetakan ke lokasi ini melalui Docker Compose.
GOOGLE_APPLICATION_CREDENTIALS=/home/airflow/.config/gcloud/application_default_credentials.json

# Jika menjalankan script langsung dari Windows host, gunakan
# override environment variable dengan path ADC Windows, contoh:
# set GOOGLE_APPLICATION_CREDENTIALS=C:\Users\TAUFIQ\AppData\Roaming\gcloud\application_default_credentials.json
# set GOOGLE_CLOUD_PROJECT=jcdeah-009

# ============================================================
# AIRFLOW AUTHENTICATION
# ============================================================
# Gunakan secret acak yang kuat.
AIRFLOW__API_AUTH__JWT_SECRET=

# ============================================================
# AIRFLOW EMAIL ALERT - GMAIL SMTP
# ============================================================
# Callback failure Airflow menggunakan Gmail SMTP dengan STARTTLS.
# Gunakan Google App Password, bukan password Gmail biasa.
AIRFLOW__EMAIL__EMAIL_BACKEND=airflow.utils.email.send_email_smtp
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=true
AIRFLOW__SMTP__SMTP_SSL=false
AIRFLOW__SMTP__SMTP_USER=yourgmail@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
AIRFLOW__SMTP__SMTP_MAIL_FROM=yourgmail@gmail.com

# Alamat email yang menerima notifikasi kegagalan pipeline.
AIRFLOW_ALERT_EMAIL=mentor@example.com

# Opsional: dapat digunakan untuk membuat Airflow Connection smtp_default.
# Callback saat ini menggunakan konfigurasi SMTP environment variable.
# Jika connection dibuat melalui Airflow, jangan simpan App Password
# secara terbuka di repository.
# AIRFLOW_CONN_SMTP_DEFAULT=smtp://yourgmail%40gmail.com:YOUR_URL_ENCODED_APP_PASSWORD@smtp.gmail.com:587

# ============================================================
# PUB/SUB
# ============================================================
DRIVER_TOPIC=driver-events
